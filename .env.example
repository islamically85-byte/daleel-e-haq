# Daleel-e-Haq (دلیلِ حق) Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit your real .env file or API keys to version control.

# Google Gemini API Key (Required for Online AI reasoning mode)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (Phase 1 default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local SQLite Database Path
DATABASE_PATH=data/local/daleel.db

# Quran & Hadith Raw Corpus Paths
CORPUS_DIR=data/corpus
